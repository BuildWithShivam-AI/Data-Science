   ],
   "source": [
    "df = pd.DataFrame({\n",
    "    'City':['Mumbai','Delhi','Pune']\n",
    "})\n",
    "encoder = OneHotEncoder(sparse_output=False)\n",
    "\n",
    "encoded = encoder.fit_transform(df[['City']])\n",
    "\n",
    "print(encoded)"
   ]
  },
